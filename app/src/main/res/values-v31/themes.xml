<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ system splash: dark background with the radar logo; the animated Compose
         splash continues seamlessly from it. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_flyx_logo</item>
    </style>
</resources>
